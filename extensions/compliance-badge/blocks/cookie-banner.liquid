{% comment %}
  Cookie Consent Banner with Preferences (App Embed)
  GDPR / CCPA - granular consent (Necessary / Analytics / Marketing)
{% endcomment %}

{% assign cg_settings = shop.metafields.complyguard.banner_settings.value %}
{% assign cg_country = localization.country.iso_code %}
<div id="complyguard-cookie-data"
     data-text="{% if cg_settings.banner_text %}{{ cg_settings.banner_text }}{% else %}{{ block.settings.banner_text }}{% endif %}"
     data-bg="{% if cg_settings.bg_color %}{{ cg_settings.bg_color }}{% else %}{{ block.settings.bg_color }}{% endif %}"
     data-color="{% if cg_settings.text_color %}{{ cg_settings.text_color }}{% else %}{{ block.settings.text_color }}{% endif %}"
     data-accept="{% if cg_settings.accept_color %}{{ cg_settings.accept_color }}{% else %}{{ block.settings.accept_color }}{% endif %}"
     data-policy="{{ block.settings.policy_url }}"
     data-country="{{ cg_country }}"
     style="display:none;"></div>

<script>
  (function() {
    var data = document.getElementById('complyguard-cookie-data');
    if (!data) return;
    if (localStorage.getItem('complyguard_consent')) return;

    // Detect visitor country (best-effort, non-blocking)
    try {
      fetch('https://ipapi.co/json/')
        .then(function(res) { return res.json(); })
        .then(function(geo) { window.__complyguardCountry = geo && geo.country_code ? geo.country_code : null; })
        .catch(function() {});
    } catch (e) {}

    var bg = data.getAttribute('data-bg');
    var color = data.getAttribute('data-color');
    var accept = data.getAttribute('data-accept');
    var policyUrl = data.getAttribute('data-policy') || '/policies/privacy-policy';

    function saveConsent(analytics, marketing, consentType) {
      var consent = { necessary: true, analytics: analytics, marketing: marketing, date: new Date().toISOString() };
      localStorage.setItem('complyguard_consent', JSON.stringify(consent));

      // Send consent to server (GDPR proof-of-consent log) with country
      try {
        var savedCountry = window.__complyguardCountry || null;
        fetch('https://api.shopiters.com/api/consent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shop: window.Shopify && window.Shopify.shop ? window.Shopify.shop : 'unknown',
            analytics: analytics,
            marketing: marketing,
            consentType: consentType || 'custom',
            country: savedCountry
          })
        }).catch(function() {});
      } catch (e) {}

      var banner = document.getElementById('complyguard-cookie-banner');
      if (banner) banner.remove();
      var modal = document.getElementById('complyguard-pref-modal');
      if (modal) modal.remove();
    }

    function injectStyles() {
      if (document.getElementById('complyguard-cookie-style')) return;
      var style = document.createElement('style');
      style.id = 'complyguard-cookie-style';
      style.textContent =
        '#complyguard-cookie-banner{position:fixed;bottom:0;left:0;right:0;z-index:99999;'
        + 'background:' + bg + ';color:' + color + ';padding:16px 20px;'
        + 'box-shadow:0 -2px 12px rgba(0,0,0,0.15);font-size:14px;line-height:1.5;}'
        + '#complyguard-cookie-banner .cg-inner{max-width:1100px;margin:0 auto;display:flex;'
        + 'flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;}'
        + '#complyguard-cookie-banner .cg-text{flex:1;min-width:240px;}'
        + '#complyguard-cookie-banner a{color:' + color + ';text-decoration:underline;}'
        + '.cg-btns{display:flex;gap:8px;flex-shrink:0;flex-wrap:wrap;}'
        + '.cg-btn{padding:9px 16px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600;border:none;}'
        + '.cg-reject{background:transparent;border:1px solid ' + color + ';color:' + color + ';}'
        + '.cg-pref{background:transparent;border:1px solid ' + color + ';color:' + color + ';}'
        + '.cg-accept{background:' + accept + ';color:#fff;}'
        + '#complyguard-pref-modal{position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,0.5);'
        + 'display:flex;align-items:center;justify-content:center;padding:20px;}'
        + '#complyguard-pref-modal .cg-box{background:#fff;color:#1f2937;border-radius:12px;'
        + 'max-width:460px;width:100%;padding:24px;box-shadow:0 10px 40px rgba(0,0,0,0.2);}'
        + '#complyguard-pref-modal h3{margin:0 0 8px;font-size:18px;}'
        + '#complyguard-pref-modal .cg-row{display:flex;align-items:center;justify-content:space-between;'
        + 'padding:12px 0;border-bottom:1px solid #eee;}'
        + '#complyguard-pref-modal .cg-row-title{font-weight:600;font-size:14px;}'
        + '#complyguard-pref-modal .cg-row-desc{font-size:12px;color:#6b7280;margin-top:2px;}'
        + '#complyguard-pref-modal .cg-save{margin-top:16px;width:100%;background:' + accept + ';'
        + 'color:#fff;border:none;padding:11px;border-radius:6px;font-weight:600;cursor:pointer;}';
      document.head.appendChild(style);
    }

    function showBanner() {
      if (document.getElementById('complyguard-cookie-banner')) return;
      injectStyles();
      var banner = document.createElement('div');
      banner.id = 'complyguard-cookie-banner';
      banner.innerHTML =
        '<div class="cg-inner">'
        + '<span class="cg-text">' + data.getAttribute('data-text')
        + ' <a href="' + policyUrl + '">Learn more</a></span>'
        + '<div class="cg-btns">'
        + '<button class="cg-btn cg-reject">Reject All</button>'
        + '<button class="cg-btn cg-pref">Preferences</button>'
        + '<button class="cg-btn cg-accept">Accept All</button>'
        + '</div></div>';
      document.body.appendChild(banner);

      banner.querySelector('.cg-accept').addEventListener('click', function() { saveConsent(true, true, 'accept_all'); });
      banner.querySelector('.cg-reject').addEventListener('click', function() { saveConsent(false, false, 'reject_all'); });
      banner.querySelector('.cg-pref').addEventListener('click', showPreferences);
    }

    function showPreferences() {
      if (document.getElementById('complyguard-pref-modal')) return;
      injectStyles();
      var modal = document.createElement('div');
      modal.id = 'complyguard-pref-modal';
      modal.innerHTML =
        '<div class="cg-box">'
        + '<h3>Cookie Preferences</h3>'
        + '<p style="font-size:13px;color:#6b7280;margin:0 0 12px;">Choose which cookies you allow. Necessary cookies are always on.</p>'
        + '<div class="cg-row"><div><div class="cg-row-title">Necessary</div>'
        + '<div class="cg-row-desc">Required for the site to work.</div></div>'
        + '<input type="checkbox" checked disabled></div>'
        + '<div class="cg-row"><div><div class="cg-row-title">Analytics</div>'
        + '<div class="cg-row-desc">Helps us understand site usage.</div></div>'
        + '<input type="checkbox" id="cg-analytics"></div>'
        + '<div class="cg-row"><div><div class="cg-row-title">Marketing</div>'
        + '<div class="cg-row-desc">Used for personalized ads.</div></div>'
        + '<input type="checkbox" id="cg-marketing"></div>'
        + '<button class="cg-save">Save Preferences</button>'
        + '<button class="cg-dns" style="margin-top:10px;width:100%;background:transparent;'
        + 'color:#6b7280;border:1px solid #d1d5db;padding:10px;border-radius:6px;'
        + 'font-weight:600;cursor:pointer;font-size:13px;">Do Not Sell My Personal Information</button>'
        + '</div>';
      document.body.appendChild(modal);

      modal.querySelector('.cg-save').addEventListener('click', function() {
        var analytics = document.getElementById('cg-analytics').checked;
        var marketing = document.getElementById('cg-marketing').checked;
        saveConsent(analytics, marketing, 'custom');
      });
      modal.querySelector('.cg-dns').addEventListener('click', function() {
        saveConsent(false, false, 'ccpa_opt_out');
      });
      modal.addEventListener('click', function(e) {
        if (e.target === modal) modal.remove();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', showBanner);
    } else {
      showBanner();
    }
  })();
</script>

{% schema %}
{
  "name": "Cookie Consent Banner",
  "target": "body",
  "settings": [
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Banner text",
      "default": "We use cookies to improve your experience and for analytics. By using our site, you agree to our use of cookies."
    },
    {
      "type": "url",
      "id": "policy_url",
      "label": "Privacy policy link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accept_color",
      "label": "Accept button color",
      "default": "#3B82F6"
    }
  ]
}
{% endschema %}