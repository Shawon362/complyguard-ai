{% comment %}
  AI Badge Auto-Embed (App Embed)
  Merchant enables once → badge auto-injects on all AI product pages
  Reads compliance.ai_generated metafield
{% endcomment %}

{% if template contains 'product' %}
  {% if product.metafields.compliance.ai_generated %}
    <style>
      .complyguard-media-wrap {
        position: relative;
      }
      .complyguard-auto-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        background: {{ block.settings.bg_color }};
        color: {{ block.settings.text_color }};
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      }
    </style>

    <script>
      (function() {
        function injectBadge() {
          if (document.querySelector('.complyguard-auto-badge')) return;

          var badge = document.createElement('div');
          badge.className = 'complyguard-auto-badge';
          badge.innerHTML = '<span>🤖</span><span>{{ block.settings.badge_text }}</span>';

          var img = document.querySelector('.product__media, .product-single__photo, [class*="product"][class*="media"] img, .product img');
          if (img) {
            var mediaBox = img.closest('.product__media, .product-single__photo, .media') || img.parentElement;
            if (mediaBox) {
              mediaBox.classList.add('complyguard-media-wrap');
              mediaBox.appendChild(badge);
              return;
            }
          }
          var form = document.querySelector('.product-form, form[action*="/cart/add"]');
          if (form) form.parentElement.insertBefore(badge, form);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', injectBadge);
        } else {
          injectBadge();
        }
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "AI Badge (Auto)",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "AI-generated image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F0F4FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3B4A9C"
    }
  ]
}
{% endschema %}